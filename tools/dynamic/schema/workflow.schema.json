{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic.oke.jp/schemas/workflow-v1.json",
  "title": "DYNAMIC workflow receipt history v1",
  "description": "Structural interchange schema. Python additionally enforces task coverage, source bindings, transitions, seals, dependencies, audit independence and readiness. This is not a security signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics_version",
    "part_id",
    "pages",
    "revision",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics_version": {
      "const": "dynamic-workflow/1"
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^p[1-9][0-9]*/(source|bars|pitch|rhythm)$": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          }
        },
        "^p[1-9][0-9]*/audit$": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/receipt"
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "complete",
                        "needs_review"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "review": {
                      "$ref": "#/$defs/review"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "status": {
          "enum": [
            "complete",
            "failed",
            "needs_review",
            "running",
            "stale"
          ]
        },
        "worker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "input_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "output_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "evidence": {
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/review"
            }
          ]
        },
        "structural_checks": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "seal": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "token",
        "status",
        "worker",
        "started_at",
        "finished_at",
        "input_hashes",
        "output_hashes",
        "evidence",
        "review",
        "structural_checks",
        "seal"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "null"
              },
              "output_hashes": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "finished_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "needs_review"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minLength": 1
              },
              "output_hashes": {
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "structural_checks": {
                "const": "passed"
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "source_sha256",
        "scope",
        "findings"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "scope": {
          "type": "array",
          "items": {
            "enum": [
              "bars",
              "cues",
              "page-boundaries",
              "pitch",
              "repeats",
              "rhythm",
              "ties"
            ]
          },
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "resolved",
                  "unresolved"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
