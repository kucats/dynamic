{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dynamic-score-reader",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dynamic.oke.jp",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only login and the memo API run the Worker script; all other paths stay static.
    "run_worker_first": ["/login", "/logout", "/api/*"]
  },
  // Practice memos: one JSON object per user and part (memos/v1/<user>/<part>.json).
  // Create once with `npx wrangler r2 bucket create dynamic-memos` before deploying.
  "r2_buckets": [
    {
      "binding": "MEMOS",
      "bucket_name": "dynamic-memos"
    }
  ],
  "vars": {
    // Cloudflare Zero Trust team domain and the Access application AUD tag for /login.
    // Leave either empty to keep the memo feature disabled.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Comma-separated reader part ids where memos are offered.
    "MEMO_PARTS": "dvorak8-trombone1"
  }
}
